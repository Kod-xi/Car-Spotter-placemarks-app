<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarSpotterApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.CarSpotterApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainScreen"
            android:exported="false"
            android:label="@string/title_activity_main_screen"
            android:theme="@style/Theme.CarSpotterApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EditScreen"
            android:exported="false"
            android:label="@string/title_activity_edit_screen"
            android:theme="@style/Theme.CarSpotterApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AddScreen"
            android:exported="false"
            android:label="@string/title_activity_add_screen"
            android:theme="@style/Theme.CarSpotterApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SearchScreen"
            android:exported="false"
            android:label="@string/title_activity_search_screen"
            android:theme="@style/Theme.CarSpotterApp"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>